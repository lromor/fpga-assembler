module(
    name = "fpga-assembler",
    version = "0.0.1",
)

# Bazel C/C++ language rules and deps.
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "abseil-cpp", version = "20260817.0")
bazel_dep(name = "googletest", version = "1.18.0.bcr.1")
bazel_dep(name = "rapidjson", version = "1.1.0.bcr.20250205")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "platforms", version = "1.1.0")

# compilation DB; build_cleaner
bazel_dep(name = "bant", version = "0.3.6")

# Cross-compile the hardware runner without changing the native toolchain.
bazel_dep(name = "llvm", version = "0.8.24", dev_dependency = True)

register_toolchains(
    "@llvm//toolchain:linux_x86_64_to_linux_armv7",
    "@llvm//toolchain:linux_aarch64_to_linux_armv7",
    "@llvm//toolchain:macos_x86_64_to_linux_armv7",
    "@llvm//toolchain:macos_aarch64_to_linux_armv7",
    "@llvm//toolchain/bootstrap:all",
    dev_dependency = True,
)
